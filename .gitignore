# Ignoreraw or processed datasets to Git
data/*
!data/raw/
data/raw/*
!data/raw/*.dvc

# Ignore common large file formats used in data science
*.csv
*.xlsx
*.parquet
*.jsonl
*.pickle
*.pkl


# Ignore experimental notebooks so they don't clutter production branches
notebooks/*
!notebooks/01 exploratory data analysis.ipynb
.ipynb_checkpoints/

# Local / not part of v1 baseline
reports/figures/*
!reports/figures/primary diagnosis by age group.png
!reports/figures/target distribution.png
docs/*
!docs/eda-findings.md
main.py
requirements.txt

# DVC cache (DVC tracks pointers, not the cache)
.dvc/cache
.dvc/tmp

# Ignore local environment variables and GenAI API keys
.env
.env.*
secrets.yaml

# Ignore local virtual environments
venv/
.venv/
env/
ENV/


# Python Artifacts & Caching
_pycache_/
*.py[cod]
*.py[oc]
*$py.class
.pytest_cache/
.coverage
htmlcov/
build/
dist/
wheels/
*.egg-info

# OS & IDE Specific Files
.DS_Store
Thumbs.db
.vscode/
.idea/
